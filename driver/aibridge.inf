[Version]
Signature = "$WINDOWS NT$"
Class = System
ClassGuid = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider = %Roxy%
DriverVer = 09/14/2026,1.0.0.0
CatalogFile = aibridge.cat
PnpLockdown = 1

[DestinationDirs]
AIBridge.CopyFiles = 13

[DefaultInstall.NTamd64]
CopyFiles = AIBridge.CopyFiles

[DefaultInstall.NTamd64.Services]
AddService = AIBridge,0x00000002,AIBridge.Service

[DefaultInstall.NTamd64.Wdf]
KmdfService = AIBridge,AIBridge.Wdf

[AIBridge.CopyFiles]
aibridge.sys

[AIBridge.Service]
DisplayName = %ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\aibridge.sys

[AIBridge.Wdf]
KmdfLibraryVersion = 1.31

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
aibridge.sys = 1

[Strings]
Roxy = "Roxy AI"
DiskName = "Roxy Kernel Bridge Driver Disk"
ServiceDesc = "Roxy AI Kernel Bridge Driver"
